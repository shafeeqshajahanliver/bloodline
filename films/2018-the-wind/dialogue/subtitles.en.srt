662
01:23:38,213 --> 01:23:41,153
[ instrumental music ]

663
01:24:11,312 --> 01:24:14,252
[ music continues ]

664
01:24:44,377 --> 01:24:47,317
[ dramatic music ]

665
01:25:17,476 --> 01:25:20,416
[ music continues ]

666
01:25:50,575 --> 01:25:53,515
[ music continues ]

667
01:26:25,991 --> 01:26:28,931
[ instrumental music ]

668
01:26:59,125 --> 01:27:02,064
[ music continues ]

669
01:27:32,224 --> 01:27:35,164
[ music continues ]

